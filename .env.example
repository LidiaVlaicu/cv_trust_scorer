# GCP project configuration
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=europe-west1
GCP_SERVICE_ACCOUNT=cv-trust-scorer-runner@your-project-id.iam.gserviceaccount.com

# GCS
# Bucket names are globally unique across all of GCP.
# Pick any unique name when you create the bucket.
GCS_BUCKET_NAME=your-bucket-name

# BigQuery datasets (scoped to your project, so these names are fine)
BQ_DATASET_BRONZE=bronze
BQ_DATASET_SILVER=silver
BQ_DATASET_GOLD=gold

# Anthropic API
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXX